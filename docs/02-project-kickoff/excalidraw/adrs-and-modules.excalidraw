    {"type":"text","id":"t2","x":80,"y":86,"width":1400,"height":22,"text":"The 8 architectural decisions that shape the code — and the src/ layout they map to.","originalText":"The 8 architectural decisions that shape the code — and the src/ layout they map to.","fontSize":14,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#94a3b8","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":3,"version":1,"versionNonce":4,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

    {"type":"text","id":"adr_h","x":80,"y":140,"width":500,"height":24,"text":"Architectural Decision Records","originalText":"Architectural Decision Records","fontSize":18,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#fbbf24","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":10,"version":1,"versionNonce":11,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},

