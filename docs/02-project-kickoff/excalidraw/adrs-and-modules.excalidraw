    {"type":"text","id":"tree_t","x":880,"y":196,"width":580,"height":500,"text":"src/\n├── cli/                arg parsing · rendering\n│   └── commands/\n│       ├── spawn.ts  drop.ts  list.ts\n│       ├── info.ts  status.ts  sync.ts\n│       ├── doctor.ts  recover.ts\n│       ├── setup.ts  env.ts  exec.ts  clean.ts\n│       ├── pr/     issue/     parallel/\n│\n├── app/                orchestration · lifecycle\n│   └── spawn.ts  drop.ts  publish.ts  parallel.ts\n│\n├── metadata/           registry · records\n│   └── registry.ts  worktree.ts  experiment.ts  schema/\n│\n├── git/                branch · worktree · status · sync\n├── setup/              profile · env\n├── parallel/           spawn · compare · pick\n├── artifact/           scaffold · validate · pr_body\n├── diagnostics/        doctor · recover\n├── publish/            push · adapters/github.ts\n├── config/             load · schema\n├── io/                 atomic writes · fs helpers\n└── log/                structured logging","originalText":"src/\n├── cli/                arg parsing · rendering\n│   └── commands/\n│       ├── spawn.ts  drop.ts  list.ts\n│       ├── info.ts  status.ts  sync.ts\n│       ├── doctor.ts  recover.ts\n│       ├── setup.ts  env.ts  exec.ts  clean.ts\n│       ├── pr/     issue/     parallel/\n│\n├── app/                orchestration · lifecycle\n│   └── spawn.ts  drop.ts  publish.ts  parallel.ts\n│\n├── metadata/           registry · records\n│   └── registry.ts  worktree.ts  experiment.ts  schema/\n│\n├── git/                branch · worktree · status · sync\n├── setup/              profile · env\n├── parallel/           spawn · compare · pick\n├── artifact/           scaffold · validate · pr_body\n├── diagnostics/        doctor · recover\n├── publish/            push · adapters/github.ts\n├── config/             load · schema\n├── io/                 atomic writes · fs helpers\n└── log/                structured logging","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#a5f3fc","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":204,"version":1,"versionNonce":205,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.35},

    {"type":"text","id":"maps","x":80,"y":640,"width":700,"height":22,"text":"ADR → module mapping","originalText":"ADR → module mapping","fontSize":16,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#fbbf24","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":300,"version":1,"versionNonce":301,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"maps_b","x":80,"y":670,"width":760,"height":220,"text":"ADR-001  single lifecycle layer    →   app/       diagnostics/\nADR-002  artifact-first            →   artifact/  app/\nADR-003  branch lifecycle owner    →   app/       git/\nADR-004  verification ≠ review     →   artifact/  (quality-gates + review)\nADR-005  parallel variants core    →   parallel/  metadata/experiment.ts\nADR-006  GitHub is an adapter      →   publish/adapters/github.ts\nADR-007  split-file metadata       →   metadata/\nADR-008  two-field status          →   metadata/schema/","originalText":"ADR-001  single lifecycle layer    →   app/       diagnostics/\nADR-002  artifact-first            →   artifact/  app/\nADR-003  branch lifecycle owner    →   app/       git/\nADR-004  verification ≠ review     →   artifact/  (quality-gates + review)\nADR-005  parallel variants core    →   parallel/  metadata/experiment.ts\nADR-006  GitHub is an adapter      →   publish/adapters/github.ts\nADR-007  split-file metadata       →   metadata/\nADR-008  two-field status          →   metadata/schema/","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#cbd5e1","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":302,"version":1,"versionNonce":303,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.7}
