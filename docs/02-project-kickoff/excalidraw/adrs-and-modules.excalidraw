    {"type":"text","id":"a1_t","x":90,"y":192,"width":340,"height":22,"text":"ADR-001  Single lifecycle layer","originalText":"ADR-001  Single lifecycle layer","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#60a5fa","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":22,"version":1,"versionNonce":23,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"a1_b","x":90,"y":216,"width":340,"height":50,"text":"Mannostree is the only layer permitted to\ncreate/remove tracked worktrees. Legacy scripts\nmust be deleted or wrap Mannostree.","originalText":"Mannostree is the only layer permitted to\ncreate/remove tracked worktrees. Legacy scripts\nmust be deleted or wrap Mannostree.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#cbd5e1","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":24,"version":1,"versionNonce":25,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

    {"type":"rectangle","id":"a2","x":80,"y":290,"width":360,"height":90,"strokeColor":"#22c55e","backgroundColor":"#052e16","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":30,"version":1,"versionNonce":31,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"a2_t","x":90,"y":302,"width":340,"height":22,"text":"ADR-002  Artifact-first orchestration","originalText":"ADR-002  Artifact-first orchestration","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":32,"version":1,"versionNonce":33,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"a2_b","x":90,"y":326,"width":340,"height":50,"text":"Every state transition requires a durable\nartifact under .task/. Chat history is transient\ncontext only — never load-bearing.","originalText":"Every state transition requires a durable\nartifact under .task/. Chat history is transient\ncontext only — never load-bearing.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#bbf7d0","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":34,"version":1,"versionNonce":35,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

    {"type":"rectangle","id":"a3","x":80,"y":400,"width":360,"height":90,"strokeColor":"#f87171","backgroundColor":"#450a0a","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":40,"version":1,"versionNonce":41,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"a3_t","x":90,"y":412,"width":340,"height":22,"text":"ADR-003  Branch lifecycle is orchestrator-owned","originalText":"ADR-003  Branch lifecycle is orchestrator-owned","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#f87171","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":42,"version":1,"versionNonce":43,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"a3_b","x":90,"y":436,"width":340,"height":50,"text":"Workers operate inside prepared worktrees.\nNever git checkout, never branch create, never\nbranch delete.","originalText":"Workers operate inside prepared worktrees.\nNever git checkout, never branch create, never\nbranch delete.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#fecaca","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":44,"version":1,"versionNonce":45,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

    {"type":"rectangle","id":"a4","x":80,"y":510,"width":360,"height":90,"strokeColor":"#a78bfa","backgroundColor":"#2e1065","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":50,"version":1,"versionNonce":51,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"a4_t","x":90,"y":522,"width":340,"height":22,"text":"ADR-004  Verification ≠ Review","originalText":"ADR-004  Verification ≠ Review","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#a78bfa","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":52,"version":1,"versionNonce":53,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"a4_b","x":90,"y":546,"width":340,"height":50,"text":"Verifier → quality-gates.md (mechanical).\nReviewer → review.md (judgment). Both required\nto reach REVIEWED.","originalText":"Verifier → quality-gates.md (mechanical).\nReviewer → review.md (judgment). Both required\nto reach REVIEWED.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#ede9fe","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":54,"version":1,"versionNonce":55,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

    {"type":"rectangle","id":"a5","x":460,"y":180,"width":360,"height":90,"strokeColor":"#f472b6","backgroundColor":"#500724","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":60,"version":1,"versionNonce":61,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"a5_t","x":470,"y":192,"width":340,"height":22,"text":"ADR-005  Parallel variants are core","originalText":"ADR-005  Parallel variants are core","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#f472b6","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":62,"version":1,"versionNonce":63,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"a5_b","x":470,"y":216,"width":340,"height":50,"text":"Experiment groups, variant naming, comparison,\nand winner selection are first-class in the data\nmodel and CLI — not an external script.","originalText":"Experiment groups, variant naming, comparison,\nand winner selection are first-class in the data\nmodel and CLI — not an external script.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#fce7f3","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":64,"version":1,"versionNonce":65,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

    {"type":"rectangle","id":"a6","x":460,"y":290,"width":360,"height":90,"strokeColor":"#34d399","backgroundColor":"#064e3b","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":70,"version":1,"versionNonce":71,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"a6_t","x":470,"y":302,"width":340,"height":22,"text":"ADR-006  GitHub is an adapter, not the core","originalText":"ADR-006  GitHub is an adapter, not the core","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#34d399","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":72,"version":1,"versionNonce":73,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"a6_b","x":470,"y":326,"width":340,"height":50,"text":"Core is host-neutral. Worktrees complete the\nfull lifecycle without ever pushing. GitLab /\nGitea pluggable later.","originalText":"Core is host-neutral. Worktrees complete the\nfull lifecycle without ever pushing. GitLab /\nGitea pluggable later.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#a7f3d0","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":74,"version":1,"versionNonce":75,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

    {"type":"rectangle","id":"a7","x":460,"y":400,"width":360,"height":90,"strokeColor":"#22c55e","backgroundColor":"#052e16","fillStyle":"solid","strokeWidth":2,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":80,"version":1,"versionNonce":81,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"a7_t","x":470,"y":412,"width":340,"height":22,"text":"ADR-007  Split-file metadata","originalText":"ADR-007  Split-file metadata","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":82,"version":1,"versionNonce":83,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"a7_b","x":470,"y":436,"width":340,"height":50,"text":"registry.json is a thin index.\nTruth lives in per-worktree records;\ncomparison state lives in per-experiment records.","originalText":"registry.json is a thin index.\nTruth lives in per-worktree records;\ncomparison state lives in per-experiment records.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#bbf7d0","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":84,"version":1,"versionNonce":85,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

