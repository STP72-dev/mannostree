    {"type":"text","id":"a8_t","x":470,"y":522,"width":340,"height":22,"text":"ADR-008  Two-field status","originalText":"ADR-008  Two-field status","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#fbbf24","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":92,"version":1,"versionNonce":93,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"a8_b","x":470,"y":546,"width":340,"height":50,"text":"status = human-friendly summary (dirty, reviewed).\nlifecycle_state = normalized machine token from\nthe canonical enum. Never overloaded.","originalText":"status = human-friendly summary (dirty, reviewed).\nlifecycle_state = normalized machine token from\nthe canonical enum. Never overloaded.","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#fef3c7","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":94,"version":1,"versionNonce":95,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

