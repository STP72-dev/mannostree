    {"type":"text","id":"r2_b","x":820,"y":410,"width":640,"height":180,"text":"{\n  \"version\": 1,  \"id\": \"experiment-retry-api-client-v1\",\n  \"kind\": \"parallel_variant\",  \"feature_name\": \"retry-api-client\",  \"variant\": \"v1\",\n  \"branch\": \"experiment/retry-api-client-v1\",  \"base_branch\": \"main\",\n  \"status\": \"reviewed\",  \"lifecycle_state\": \"REVIEWED\",\n  \"validation\": { \"status\": \"passed\", \"commands\": [ { \"command\": \"npm test\", \"status\": \"passed\" } ] },\n  \"review\":     { \"status\": \"passed_with_suggestions\", \"critical_count\": 0 },\n  \"parallel\":   { \"experiment_name\": \"retry-api-client\", \"winner\": false },\n  \"summary\":    { \"files_changed\": 8, \"lines_added\": 210, \"lines_removed\": 34 }\n}","originalText":"{\n  \"version\": 1,  \"id\": \"experiment-retry-api-client-v1\",\n  \"kind\": \"parallel_variant\",  \"feature_name\": \"retry-api-client\",  \"variant\": \"v1\",\n  \"branch\": \"experiment/retry-api-client-v1\",  \"base_branch\": \"main\",\n  \"status\": \"reviewed\",  \"lifecycle_state\": \"REVIEWED\",\n  \"validation\": { \"status\": \"passed\", \"commands\": [ { \"command\": \"npm test\", \"status\": \"passed\" } ] },\n  \"review\":     { \"status\": \"passed_with_suggestions\", \"critical_count\": 0 },\n  \"parallel\":   { \"experiment_name\": \"retry-api-client\", \"winner\": false },\n  \"summary\":    { \"files_changed\": 8, \"lines_added\": 210, \"lines_removed\": 34 }\n}","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":54,"version":1,"versionNonce":55,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

