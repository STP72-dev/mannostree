    {"type":"text","id":"tree_t","x":100,"y":198,"width":640,"height":500,"text":"<repo-root>/\n├── .mannostree.yml                            ← config / policy\n│\n├── .mannostree/                               ← metadata store\n│   ├── registry.json                          ← discovery index\n│   ├── worktrees/\n│   │   ├── feature-retry.json                 ← per-worktree truth\n│   │   ├── experiment-retry-v1.json\n│   │   ├── experiment-retry-v2.json\n│   │   └── experiment-retry-v3.json\n│   ├── experiments/\n│   │   ├── retry-api-client.json              ← per-experiment state\n│   │   └── retry-api-client/\n│   │       └── comparison.md                  ← winner rationale\n│   └── archive/\n│       └── <id>.json                          ← dropped records\n│\n└── .worktrees/                                ← actual git worktrees\n    ├── retry/\n    │   ├── .task/\n    │   │   ├── task-contract.md\n    │   │   ├── solution-options.md\n    │   │   ├── implementation-plan.md\n    │   │   ├── quality-gates.md\n    │   │   ├── review.md\n    │   │   └── pr-body.md\n    │   └── RESULTS.md\n    ├── retry-v1/   .task/ + RESULTS.md\n    ├── retry-v2/   .task/ + RESULTS.md\n    └── retry-v3/   .task/ + RESULTS.md","originalText":"<repo-root>/\n├── .mannostree.yml                            ← config / policy\n│\n├── .mannostree/                               ← metadata store\n│   ├── registry.json                          ← discovery index\n│   ├── worktrees/\n│   │   ├── feature-retry.json                 ← per-worktree truth\n│   │   ├── experiment-retry-v1.json\n│   │   ├── experiment-retry-v2.json\n│   │   └── experiment-retry-v3.json\n│   ├── experiments/\n│   │   ├── retry-api-client.json              ← per-experiment state\n│   │   └── retry-api-client/\n│   │       └── comparison.md                  ← winner rationale\n│   └── archive/\n│       └── <id>.json                          ← dropped records\n│\n└── .worktrees/                                ← actual git worktrees\n    ├── retry/\n    │   ├── .task/\n    │   │   ├── task-contract.md\n    │   │   ├── solution-options.md\n    │   │   ├── implementation-plan.md\n    │   │   ├── quality-gates.md\n    │   │   ├── review.md\n    │   │   └── pr-body.md\n    │   └── RESULTS.md\n    ├── retry-v1/   .task/ + RESULTS.md\n    ├── retry-v2/   .task/ + RESULTS.md\n    └── retry-v3/   .task/ + RESULTS.md","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#a5f3fc","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":22,"version":1,"versionNonce":23,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.35},

