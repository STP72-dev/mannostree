    {"type":"text","id":"r3_b","x":820,"y":660,"width":640,"height":150,"text":"{\n  \"version\": 1,  \"name\": \"retry-api-client\",  \"kind\": \"parallel_experiment\",\n  \"base_branch\": \"main\",  \"plan_mode\": \"shared\",  \"max_variants\": 5,\n  \"variants\": [ v1, v2, v3 ],\n  \"comparison\": { \"completed\": true, \"comparison_file\": \".mannostree/experiments/retry-api-client/comparison.md\" },\n  \"winner\":     { \"selected\": true, \"variant_id\": \"experiment-retry-api-client-v2\",\n                  \"reason\": \"best balance of scope and risk\" },\n  \"publish\":    { \"pr_created\": false }\n}","originalText":"{\n  \"version\": 1,  \"name\": \"retry-api-client\",  \"kind\": \"parallel_experiment\",\n  \"base_branch\": \"main\",  \"plan_mode\": \"shared\",  \"max_variants\": 5,\n  \"variants\": [ v1, v2, v3 ],\n  \"comparison\": { \"completed\": true, \"comparison_file\": \".mannostree/experiments/retry-api-client/comparison.md\" },\n  \"winner\":     { \"selected\": true, \"variant_id\": \"experiment-retry-api-client-v2\",\n                  \"reason\": \"best balance of scope and risk\" },\n  \"publish\":    { \"pr_created\": false }\n}","fontSize":11,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":64,"version":1,"versionNonce":65,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

