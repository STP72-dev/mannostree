    {"type":"text","id":"iface_hdr","x":80,"y":440,"width":600,"height":26,"text":"Adapter interface (TypeScript)","originalText":"Adapter interface (TypeScript)","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#60a5fa","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":100,"version":1,"versionNonce":101,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"code","x":80,"y":480,"width":760,"height":250,"strokeColor":"#334155","backgroundColor":"#020617","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":102,"version":1,"versionNonce":103,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"code_t","x":100,"y":498,"width":720,"height":230,"text":"interface PublishAdapter {\n  name: string;\n  pushBranch(input: { branch: string; remote: string }): Promise<PushResult>;\n  openPullRequest(input: {\n    branch: string; base: string; title: string;\n    body: string; draft: boolean; labels?: string[];\n  }): Promise<PullRequestRef>;\n  getPullRequest(ref: PullRequestRef): Promise<PullRequestState>;\n  getChecks(ref: PullRequestRef): Promise<ChecksSummary>;\n}\n\ninterface IssueAdapter {\n  name: string;\n  fetchIssue(ref: string): Promise<{ title; body; url; number }>;\n}","originalText":"interface PublishAdapter {\n  name: string;\n  pushBranch(input: { branch: string; remote: string }): Promise<PushResult>;\n  openPullRequest(input: {\n    branch: string; base: string; title: string;\n    body: string; draft: boolean; labels?: string[];\n  }): Promise<PullRequestRef>;\n  getPullRequest(ref: PullRequestRef): Promise<PullRequestState>;\n  getChecks(ref: PullRequestRef): Promise<ChecksSummary>;\n}\n\ninterface IssueAdapter {\n  name: string;\n  fetchIssue(ref: string): Promise<{ title; body; url; number }>;\n}","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#a5f3fc","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":104,"version":1,"versionNonce":105,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.45},

    {"type":"text","id":"rules_hdr","x":880,"y":440,"width":600,"height":26,"text":"Hard rules","originalText":"Hard rules","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#f87171","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":110,"version":1,"versionNonce":111,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"text","id":"rules","x":880,"y":480,"width":580,"height":250,"text":"1.  Core never imports GitHub code. Only the interface.\n\n2.  Lifecycle states are host-neutral. PR_OPEN means\n    'published to a host', not 'GitHub PR'.\n\n3.  Mannostree never merges. Merging is the host's UI.\n\n4.  GitHub failures must not corrupt local state.\n    Push failure → roll back metadata. PR-create failure\n    → worktree stays in REVIEWED, not PR_OPEN.\n\n5.  No .task/ artifact requires GitHub to exist.","originalText":"1.  Core never imports GitHub code. Only the interface.\n\n2.  Lifecycle states are host-neutral. PR_OPEN means\n    'published to a host', not 'GitHub PR'.\n\n3.  Mannostree never merges. Merging is the host's UI.\n\n4.  GitHub failures must not corrupt local state.\n    Push failure → roll back metadata. PR-create failure\n    → worktree stays in REVIEWED, not PR_OPEN.\n\n5.  No .task/ artifact requires GitHub to exist.","fontSize":13,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#fecaca","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":112,"version":1,"versionNonce":113,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.5},

    {"type":"text","id":"pr_hdr","x":80,"y":760,"width":600,"height":26,"text":"PR body composition (from artifacts)","originalText":"PR body composition (from artifacts)","fontSize":17,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#22c55e","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":120,"version":1,"versionNonce":121,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.25},
    {"type":"rectangle","id":"pr_b","x":80,"y":800,"width":1400,"height":140,"strokeColor":"#22c55e","backgroundColor":"#052e16","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":122,"version":1,"versionNonce":123,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"roundness":{"type":3}},
    {"type":"text","id":"pr_t","x":100,"y":816,"width":1360,"height":120,"text":"## Summary       ←  RESULTS.md → Summary\n## Changes       ←  RESULTS.md → Files changed\n## Validation    ←  quality-gates.md\n## Review        ←  review.md → Verdict + Critical/Major/Minor counts\n## Comparison    ←  comparison.md (parallel only)\n## Notes         ←  RESULTS.md → Notes (optional)","originalText":"## Summary       ←  RESULTS.md → Summary\n## Changes       ←  RESULTS.md → Files changed\n## Validation    ←  quality-gates.md\n## Review        ←  review.md → Verdict + Critical/Major/Minor counts\n## Comparison    ←  comparison.md (parallel only)\n## Notes         ←  RESULTS.md → Notes (optional)","fontSize":12,"fontFamily":3,"textAlign":"left","verticalAlign":"top","strokeColor":"#86efac","backgroundColor":"transparent","fillStyle":"solid","strokeWidth":1,"strokeStyle":"solid","roughness":0,"opacity":100,"angle":0,"seed":124,"version":1,"versionNonce":125,"isDeleted":false,"groupIds":[],"boundElements":null,"link":null,"locked":false,"containerId":null,"lineHeight":1.55}
  ],
